        </mxCell>
        <mxCell id="upd-inputs-note" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=18;" value="Head input = these vectors concatenated, rebuilt at every step" vertex="1">
          <mxGeometry height="30" width="800" x="2340" y="-640" as="geometry" />
        </mxCell>
        <mxCell id="upd-critic-note" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="remaining slots × 0.01 is applied after the network, it is not an input.&lt;br&gt;V(s) is only used in training, to compute advantages." vertex="1">
          <mxGeometry height="80" width="410" x="3210" y="785" as="geometry" />
        </mxCell>
        <mxCell id="upd-mask" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#D5E8D4,#1F2F1E);strokeColor=#2D7600;" value="&lt;font style=&quot;font-size: 20px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Action mask&lt;/b&gt;&lt;br&gt;employees who can't cover the slot → −∞&lt;br&gt;(vacation, already working that day, limits, rest rule)&lt;br&gt;&lt;br&gt;PASS allowed only on CAPACITY slots, or when nobody can cover&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="440" x="4440" y="-98" as="geometry" />
        </mxCell>
        <mxCell id="upd-softmax" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#D5E8D4,#1F2F1E);strokeColor=#2D7600;" value="&lt;font style=&quot;font-size: 20px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;softmax&lt;/b&gt;&lt;br&gt;probabilities over&lt;br&gt;E employees + PASS&lt;br&gt;→ sample the action&lt;/font&gt;" vertex="1">
          <mxGeometry height="144" width="330" x="4960" y="-55" as="geometry" />
        </mxCell>
        <mxCell id="upd-join-mask" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;" value="" source="-msoa_Bg8a7w-dpp6nea-22" target="upd-mask">
