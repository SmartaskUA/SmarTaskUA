# Copy this file to .env (or .env.production) and adjust per environment.
# See docs/frontend/simple-mode.md for full details.

# When "true", hides the Manual scheduling mode and restricts the Problem
# mode's algorithm picker to only the two Mathematical Formulation (MD7)
# solvers (ILP_Sisqual_Hours_MathematicalDefinition7 /
# CSP_Sisqual_Hours_MathematicalDefinition7). Intended for production.
# Leave unset or "false" for the full developer experience.
VITE_SIMPLE_MODE=false
