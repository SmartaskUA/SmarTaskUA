  "challenges": {
    "challenge1_dayOffOptimization": {
      "name": "Otimização de Trocas de Folgas",
      "description": "Minimize day-off swaps while maximizing service coverage",
      "enabled": true,
      "objective": "balanced",
      "swapPenalty": 10,
      "coverageReward": 100,
      "rules": [
        "Only DLV (variable day-offs) can be swapped",
        "Swaps must occur within same week",
        "Part-time employees cannot have day-offs swapped",
        "Red markings (isFixed=true) cannot be modified"
      ]
    },
    "challenge2_competencyOrdering": {
      "name": "Preenchimento por Ordem de Competência",
      "description": "Fill teams by competency priority order respecting resource allocation",
      "enabled": true,
      "respectResourceRule": true,
      "dynamicOrdering": true,
      "rules": [
        "Follow priority hierarchy (1-9)",
        "Order may vary by day/time based on KPI needs",
        "Don't use ideal if minimum of another task unmet"
      ]
    },
    "challenge3_multiCompetencyAllocation": {
      "name": "Decisão de Alocação para Colaboradores com Múltiplas Competências",
      "description": "Optimal competency selection for multi-skilled employees",
      "enabled": true,
      "allocationStrategy": "hybrid",
      "considerLongTerm": true,
      "levelWeight": 0.5,
      "priorityWeight": 0.5,
      "innovationNote": "This algorithm is an innovation - no similar solution exists in market",
      "factors": [
        "Alarm priority hierarchy",
        "Employee competency levels",
        "KPI fulfillment (minimo, ideal, estimado)",
        "Long-term impact on future periods"
      ]
    },
    "challenge4_breakManagement": {
      "name": "Gestão de Pausas",
      "description": "Two variants: with breaks (complex) or without breaks (simple)",
      "mode": "without_breaks",
      "variants": {
        "without_breaks": {
          "description": "Meal period included in shift duration",
          "complexity": "lower"
        },
        "with_breaks": {
          "description": "Explicit break scheduling based on country legislation",
          "complexity": "higher",
          "breakRules": [
            {
              "minShiftDuration": 6,
              "breakDuration": 30,
              "breakType": "meal"
            },
            {
              "minShiftDuration": 4,
              "breakDuration": 15,
              "breakType": "rest"
            }
          ]
        }
      }
    }
  },

  "openQuestions": {
    "note": "Questions from Section 'Questões em Aberto' in PDF",
    "question1": "When minimum employees < sum of minimums per task, can employees cover multiple tasks simultaneously?",
    "question2": "Should DLF, VAC, and EnfD be treated identically algorithmically (all = unavailable)?",
    "question3": "Any preferences/restrictions for JSON structure for Sisqual internal systems?",
    "question4": "Week definition: Monday-Sunday or Sunday-Saturday?",
    "question5": "Single ALM-1 employee covers all warehouse needs Mon-Fri but creates inflexibility - acceptable?",
    "question6": "What does DC-E marking mean?",
    "question7": "Are Estimated values available for Caixa, Gestão, and Armazém teams (currently only for Empregados)?"
