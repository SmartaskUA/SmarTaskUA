{
  "schemaVersion": "2.1",
  "problemType": "employee_scheduling",

  "metadata": {
    "problemId": "SMARTASK_SIMPLE_2025",
    "createdAt": "2025-01-01T00:00:00Z",
    "description": "Simple team-based scheduling problem derived from VacationTemplate.csv and minimuns.csv",
    "source": "SmarTask Relatorio Tecnico - simple case"
  },

  "features": {
    "useShiftBasedScheduling": true,
    "useAdvancedConstraints": false,
    "usePriorityHierarchy": false
  },

  "temporalScope": {
    "year": 2025,
    "numDays": 365,
    "targetPeriod": {
      "start": "2025-01-01",
      "end": "2025-12-31",
      "includeBufferWeeks": false
    }
  },

  "employees": {
    "model": "team",
    "simple": [
      {"id": "Employee 1", "name": "Employee 1", "teams": ["A"]},
      {"id": "Employee 2", "name": "Employee 2", "teams": ["A"]},
      {"id": "Employee 3", "name": "Employee 3", "teams": ["A"]},
      {"id": "Employee 4", "name": "Employee 4", "teams": ["A"]},
      {"id": "Employee 5", "name": "Employee 5", "teams": ["A"]},
      {"id": "Employee 6", "name": "Employee 6", "teams": ["A"]},
      {"id": "Employee 7", "name": "Employee 7", "teams": ["A"]},
      {"id": "Employee 8", "name": "Employee 8", "teams": ["A", "B"]},
      {"id": "Employee 9", "name": "Employee 9", "teams": ["A", "B"]},
      {"id": "Employee 10", "name": "Employee 10", "teams": ["A", "B"]},
      {"id": "Employee 11", "name": "Employee 11", "teams": ["B"]},
      {"id": "Employee 12", "name": "Employee 12", "teams": ["B"]}
    ]
  },

  "demand": {
    "shiftModel": "fixed",
    "dataFile": "demand.csv",
    "organizationalUnits": {
      "teams": ["A", "B"]
    },
    "shifts": [
      {
        "code": "M",
        "name": "Morning",
        "order": 1,
        "timeRange": {
          "start": "08:00",
          "end": "16:00"
        }
      },
      {
        "code": "T",
        "name": "Afternoon",
        "order": 2,
        "timeRange": {
          "start": "14:00",
          "end": "22:00"
        }
      }
    ]
  },

  "scheduleInput": {
    "dataFile": "schedule_input.csv",
    "markingTypes": {
      "A": "Available",
      "VAC": "Vacation"
    }
  },

  "constraints": {
    "hard": [
      {
        "id": "max-consecutive-days",
        "type": "max_consecutive_days",
        "params": {
          "window": 6,
          "max_worked": 5
        },
        "enabled": true
      },
      {
        "id": "total-workdays",
        "type": "total_workdays",
        "params": {
          "min": 223,
          "max": 223
        },
        "enabled": true
      },
      {
        "id": "max-special-days",
        "type": "max_special_days",
        "params": {
          "cap": 22
        },
        "enabled": true
      },
      {
        "id": "no-backward-shift-transitions",
        "type": "no_earlier_shift_next_day",
        "params": {},
        "enabled": true
      },
      {
        "id": "vacation-days",
        "type": "vacation_block",
        "params": {},
        "enabled": true
      }
    ],
    "soft": [
      {
        "id": "min-coverage",
        "type": "min_coverage",
        "params": {
          "penalty_per_missing": 100
        },
        "weight": 1000,
        "enabled": true
      },
      {
        "id": "ideal-coverage",
        "type": "ideal_coverage",
        "params": {
          "penalty_per_missing": 1
        },
        "weight": 100,
        "enabled": true
      }
    ]
  },

  "optimization": {
    "algorithm": "CSPv2",
    "maxTimeMinutes": 10,
    "objectives": [
      {
        "goal": "minimize_shortages",
        "weight": 1000,
        "priority": 1
      },
      {
        "goal": "balance_workload",
        "weight": 10,
        "priority": 2
      }
    ]
  }
}
